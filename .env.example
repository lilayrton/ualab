SITE_URL=http://localhost:3000

# Tipo de base de datos: mongo | sql
DB_TYPE=mongo

# Si DB_TYPE=mongo
# Atlas
DATABASE=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local
#DATABASE=mongodb://127.0.0.1:27017/ualab

# Si DB_TYPE=sql
# mssql | mysql | mariadb | postgres | sqlite
DB_DIALECT=mssql

# Las siguientes configuraciones no aplican a SQLite
# Puertos: mssql: 1433 | mysql/mariadb: 3306 | postgres: 5432
DB_NAME=ualab
DB_HOST=localhost
DB_PORT=1433
DB_USER=
DB_PASSWORD=

# Sólo mssql
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Sólo postgres
DB_SSL=false

# Sólo sqlite
DB_STORAGE=./ualab.sqlite

# Configuración para el servidor
HOST=127.0.0.1
PORT=33000

# Secretos
JWT_SECRET=

# Secret dedicado para los tokens de recuperación de contraseña.
# Si queda vacío se usa JWT_SECRET como backup.
RESET_SECRET=

# SMTP para el envío de mails. Si están vacíos, el envío se simula por consola
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Directorio de subida de imágenes
UPLOAD_DIR=img/
