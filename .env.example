SITE_URL=http://localhost:3000

# Tipo de base de datos: mongo | sql
DB_TYPE=mongo

# Si DB_TYPE=mongo
# Atlas
DATABASE=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local
#DATABASE=mongodb://127.0.0.1:27017/ualab

# Si DB_TYPE=sql
# mssql | mysql | mariadb | postgres | sqlite
DB_DIALECT=mssql

# Las siguientes configuraciones no aplican a SQLite
# Puertos: mssql: 1433 | mysql/mariadb: 3306 | postgres: 5432
DB_NAME=ualab
DB_HOST=localhost
DB_PORT=1433
DB_USER=
DB_PASSWORD=

# Sólo mssql
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Crear la base automáticamente si no existe
DB_AUTO_CREATE=false

# Sólo postgres
DB_SSL=false

# Sólo sqlite
DB_STORAGE=./ualab.sqlite

# Estrategia CORS (separados por coma)
# Si queda vacío, se permite cualquier origen (ideal para desarrollo)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# SameSite de la cookie de sesión
# 'lax' (default) alcanza entre subdominios del mismo sitio y en localhost.
# 'none' es solo para producción cuando frontend y API están en dominios distintos (requiere HTTPS).
COOKIE_SAME_SITE=lax

# Confía en X-Forwarded-For cuando la API está detrás de un reverse proxy
TRUST_PROXY=false

# Configuración para el servidor
HOST=127.0.0.1
PORT=33000

# Secretos
JWT_SECRET=

# Secret dedicado para los tokens de recuperación de contraseña
# Si queda vacío se usa JWT_SECRET como backup
RESET_SECRET=

# SMTP para el envío de mails. Si están vacíos, el envío se simula por consola
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Directorio de subida de imágenes
UPLOAD_DIR=img/

# Mail de destino de las consultas
# Si es vacío, se usa el mail de la tienda y, como último recurso, la variable SMTP_USER
CONTACT_EMAIL=

# Límite de envíos del formulario de consultas (ventana deslizante por IP)
# Ayuda a que los mails no caigan en spam
INQUIRY_RATE_LIMIT_MAX=5
INQUIRY_RATE_LIMIT_WINDOW_MS=900000

# Límite de intentos de register/login/forgot-password/reset-password por IP
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
